         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Communicable Diseases Intelligence - Opportunities to strengthen respiratory virus surveillance systems in Australia: lessons learned from the COVID-19 response</rdf:li>
            </rdf:Alt>
         </dc:title>
